#version 420 core
out vec4 FragColor;

in vec2 TexCoords;

uniform sampler2D sceneTex;
float threshold = 1.0;  // you can hardcode or set from C++

void main()
{
    vec3 color = texture(sceneTex, TexCoords).rgb;

    // Simple brightness check (can use luminance or max RGB)
    float brightness = dot(color, vec3(0.2126, 0.7152, 0.0722)); // luminance
    if (brightness > threshold)
        FragColor = vec4(color, 1.0); // keep bright fragment
    else
        FragColor = vec4(0.0); // discard dark fragment
}
