#version 430
layout(local_size_x = 2, local_size_y = 2) in;

// INPUT: heightfield has a 1-texel border on all sides -> size = (W+2, H+2)
layout(binding = 0) uniform sampler2D heightfield;  // use texelFetch, not texture()

// OUTPUT: one normal per vertex -> size = (W, H)
layout(binding = 1, rgba32f) uniform writeonly image2D normalMap;
layout(binding = 2, rgba32f) uniform writeonly image2D tangentMap;
layout(binding = 3, rgba32f) uniform writeonly image2D bitangentMap;

uniform float chunkWorldSize;  // TerrainConfig::gridSize, set from C++ each dispatch
uniform float minHeight;
uniform float maxHeight;
uniform float heightScale;

void main() {
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(normalMap);  // (W, H)
    if (any(greaterThanEqual(outCoord, outSize))) return;

    // Map output coord (W,H) -> input coord (W+2,H+2): skip the 1-texel border
    ivec2 inCoord = outCoord + ivec2(1);  // [1..W, 1..H]

    // Orthogonal neighbor heights from the border-inclusive heightfield
    float hL = texelFetch(heightfield, inCoord + ivec2(-1, 0), 0).r;
    float hR = texelFetch(heightfield, inCoord + ivec2(1, 0), 0).r;
    float hD = texelFetch(heightfield, inCoord + ivec2(0, -1), 0).r;
    float hU = texelFetch(heightfield, inCoord + ivec2(0, 1), 0).r;

    // Diagonal neighbors, added so the slope estimate is a 3x3 Sobel kernel instead of a bare
    // 4-neighbor central difference -> smooths out per-texel heightfield noise in the normal map.
    float hTL = texelFetch(heightfield, inCoord + ivec2(-1, 1), 0).r;
    float hTR = texelFetch(heightfield, inCoord + ivec2(1, 1), 0).r;
    float hBL = texelFetch(heightfield, inCoord + ivec2(-1, -1), 0).r;
    float hBR = texelFetch(heightfield, inCoord + ivec2(1, -1), 0).r;

    // World-space step: matches your vertex spacing
    vec2 worldStep = vec2(chunkWorldSize) / (vec2(outSize) - vec2(1.0));

    // Sobel-weighted height deltas, rescaled by /4 (total one-sided kernel weight) so they stay on
    // the same scale as the plain (hR - hL) / (hU - hD) differences they replace.
    float dX = ((hTR - hTL) + 2.0 * (hR - hL) + (hBR - hBL)) * 0.25;
    float dZ = ((hTL + 2.0 * hU + hTR) - (hBL + 2.0 * hD + hBR)) * 0.25;

    // Build tangent vectors (Y is up; X/Z are horizontal axes)
    vec3 tx = vec3(2.0 * worldStep.x, dX, 0.0);
    vec3 tz = vec3(0.0, -dZ, -2.0 * worldStep.y);

    // Cross with correct winding so the normal points up
    vec3 N = normalize(cross(tx, tz));

    // Tangent along X axis
    vec3 T = normalize(tx);

    // Bitangent along Z axis (orthonormal with N)
    vec3 B = normalize(cross(N, T));

    // Pack to [0,1] and store
    imageStore(normalMap, outCoord, vec4(N * 0.5 + 0.5, 1.0));
    imageStore(tangentMap, outCoord, vec4(T * 0.5 + 0.5, 1.0));
    imageStore(bitangentMap, outCoord, vec4(B * 0.5 + 0.5, 1.0));
}
